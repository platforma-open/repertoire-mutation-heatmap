// Mutation Explorer — workflow.
//
// The profiler emits the per-variant state matrix [variantKey, parentId, position] -> state.
// This block reads it, scopes everything to one parent, and precalculates two position ×
// residue maps. Neither is a population marginal: no view here aggregates over the variants
// carrying a residue. The aggregated state heat map that did was removed.
//
// Mutation landscape. Per-variant score columns plotted over the single-mutant subset only, so
// a cell is one variant's own value rather than a summary over every genetic background the
// substitution co-occurs with. Output: ONE value column per selected score, each
// [position, state] -> cellValue, scoped to the one selected parent. Present only when score
// columns are selected.
//
// Enrichment analysis. Per-position, per-residue log2 fold change of residue composition in
// each selection round against the baseline round. Output:
// [round, parentId, position, state] -> log2fc. Needs at least two rounds.
//
// Both maps ride alongside two position-keyed annotation tracks — region membership and the
// parent residue — which GraphMaker renders under the X axis.

wf := import("@platforma-sdk/workflow-tengo:workflow")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
pt := import("@platforma-sdk/workflow-tengo:pt")
maps := import("@platforma-sdk/workflow-tengo:maps")
units := import("@platforma-sdk/workflow-tengo:units")

// Join keys must stay byte-identical to the profiler's emitted axis names.
VARIANT_KEY_AXIS := "pl7.app/variantKey"
PARENT_ID_AXIS := "pl7.app/repertoire/parentId"
POSITION_AXIS := "pl7.app/repertoire/position"

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	bb.ignoreMissingDomains()
	// State matrix as the anchor — lets profiler-keyed property ids resolve.
	bb.addAnchor("main", args.stateMatrixRef)
	// Per-position region membership [parentId, position] -> region, from the profiler.
	// addMulti (not addSingle) so it resolves to empty when absent — nt state matrix or a
	// run with no region scheme — instead of failing. Matched on the state-matrix parentId
	// (idx 1) + position (idx 2) axes; the body collapses it to a position-keyed track.
	bb.addMulti({
		name: "pl7.app/repertoire/regionAnnotation",
		axes: [{ anchor: "main", idx: 1 }, { anchor: "main", idx: 2 }]
	}, "regionAnnotation")
	// The narrower reading of the same membership, present only when the profiler run
	// subdivided a region: a graft reads as itself rather than as the region containing it.
	// addMulti for the same reason as above — it is absent on any run without grafts, and on
	// every run made before the profiler emitted it.
	bb.addMulti({
		name: "pl7.app/repertoire/subRegionAnnotation",
		axes: [{ anchor: "main", idx: 1 }, { anchor: "main", idx: 2 }]
	}, "subRegionAnnotation")
	// Parent residue per position [parentId, position] -> residue, from the profiler — the
	// reference the single-mutant predicate differences against. Matched on the same
	// state-matrix axes as the region track. addMulti so a run made before the profiler
	// exported it resolves to empty and the body's fallback takes over.
	bb.addMulti({
		name: "pl7.app/repertoire/parentResidue",
		axes: [{ anchor: "main", idx: 1 }, { anchor: "main", idx: 2 }]
	}, "parentResidue")
	// Per-variant mutation count from the profiler, keyed on the state matrix's variantKey axis
	// (idx 0). Drives the mutation landscape's `mutationCount == 1` predicate. addMulti so a
	// run that did not emit it resolves to empty and the landscape is simply skipped, rather than
	// failing the whole workflow.
	bb.addMulti({
		name: "pl7.app/repertoire/mutationCount",
		axes: [{ anchor: "main", idx: 0 }]
	}, "mutationCount")
	// Per-variant score columns for the mutation landscape. Same shape as the round
	// frequencies: ids come from the model's discover() (anchored on `main`), added without a
	// query key and retrieved by the ref itself in the body.
	if !is_undefined(args.scoreRefs) {
		for ref in args.scoreRefs {
			bb.addSingle(ref)
		}
	}
	// Per-round frequency columns from the enrichment block (composition-enrichment view).
	// Anchored on `main` like the scores: these are keyed on variantKey alone, which the state
	// matrix carries. Ids come from the model's discover() and are added without a query key,
	// retrieved by the ref itself in the body.
	if !is_undefined(args.roundFrequencyRefs) && len(args.roundFrequencyRefs) >= 2 {
		for ref in args.roundFrequencyRefs {
			bb.addSingle(ref)
		}
	}
	return {
		columns: bb.build()
	}
})

wf.body(func(args) {
	// No early bail-out on a missing value source: every view here is optional and guarded on
	// its own inputs, so a run with only a dataset and a parent legitimately produces just the
	// position-keyed annotation tracks. The parent list is not produced here either — the UI
	// enumerates parents from the result pool before this runs.
	columns := args.columns
	stateSpec := columns.getSpec(args.stateMatrixRef)
	stateCol := columns.getColumn(args.stateMatrixRef)

	// State-matrix axes, in emitted order [variantKey, parentId, position].
	parentAxisSpec := stateSpec.axesSpec[1]
	alphabet := stateSpec.axesSpec[2].domain["pl7.app/alphabet"]
	// X-axis (position) label: override the profiler's inherited "Position aa"/"Position nt"
	// with upper-cased "Position AA"/"Position NT" for the heat map plots. Label is an
	// annotation (no identity impact); reused across every plot's position axis below.
	positionAxisSpec := maps.deepMerge(stateSpec.axesSpec[2], {
		annotations: { "pl7.app/label": (alphabet == "aminoacid") ? "Position AA" : "Position NT" }
	})
	// Y-axis (state) label, alphabet-aware: residues for the aa matrix, bases for nt.
	stateAxisLabel := (alphabet == "aminoacid") ? "Amino Acids" : "Nucleotides"

	// The landscape's cell is (position, state), and its parent-residue cell is ABSENT by
	// construction: a single mutant differs from its parent, so no variant carries the parent
	// residue at its own position. Marking that cell needs it to exist, so both cell axes are
	// declared dense and graph-maker asks the engine for the full position x state grid, with an
	// absent value wherever no single mutant covered the substitution. Identity is name + type +
	// domain, so these annotated copies still join with the position-keyed annotation tracks.
	densePositionAxisSpec := maps.deepMerge(positionAxisSpec, {
		annotations: { "pl7.app/graph/isDenseAxis": "true" }
	})
	stateAxisSpecBase := {
		name: "pl7.app/repertoire/state",
		type: "String",
		domain: {
			"pl7.app/alphabet": alphabet
		},
		annotations: {
			"pl7.app/label": stateAxisLabel,
			"pl7.app/table/fontFamily": "monospace"
		}
	}
	denseStateAxisSpec := maps.deepMerge(stateAxisSpecBase, {
		annotations: { "pl7.app/graph/isDenseAxis": "true" }
	})

	// The substitution designator (`A5C`) the drill-down outputs are keyed on. One string axis
	// rather than a (position, residue) pair, so a chart pins to one mutation with a single
	// equality filter, and the same value is the section label and the query parameter.
	mutationIdAxisSpec := {
		name: "pl7.app/repertoire/mutationId",
		type: "String",
		domain: {
			"pl7.app/alphabet": alphabet
		},
		annotations: {
			"pl7.app/label": "Mutation",
			"pl7.app/table/fontFamily": "monospace"
		}
	}

	// --- Shared frames ---
	// Every PColumn is read straight through pframes-rs: pt.p.column emits a
	// `read_frame` step, which is a lazy parquet scan (and the one read path ptabler
	// gives a spill directory). The previous route went through
	// pframes.tsvFileBuilder, whose build() calls xsv.exportFrame to write the WHOLE
	// column out as a TSV before this workflow reads it back. Both halves stream, so
	// it was never a memory problem — but the state matrix is
	// `distinctVariants x parentLength` rows, so on a DMS-scale run that round trip
	// costs tens of GB of scratch and two extra full passes for no gain.
	//
	// RAM. The auto-sizer measures `f.size()`, which counts only inputs attached with
	// `addFile()` — and this workflow attaches none, reading every input through
	// `pt.p.column`. So the measured volume is ZERO and the run receives exactly the floor,
	// whatever the data actually is. That is why a library profiled at a higher mutation limit
	// killed the step: the state matrix is `variants x parentLength` rows — ~118M on a 1.08M
	// variant run — and the request was still the 2 GiB default, the same as for a 2M row one.
	//
	// `.mem()` because the pinned workflow-tengo (6.9.0) has no `memFloor`, which would have
	// raised the floor while leaving auto-sizing on. Here the two are equivalent anyway: with
	// measured volume at zero the formula returns the floor regardless.
	//
	// Where 24 GiB comes from — pt's own formula, applied by hand to the volume it cannot see:
	//
	//     ram = 2 GiB + 6 x size          (:pt.sizing, size = uncompressed input bytes)
	//
	// The state matrix is `variants x parentLength` rows: ~118M on a 1.08M variant library at
	// 110 positions. A row is variantKey (16 chars) + parentId + position + state plus
	// separators, ~26 B uncompressed, so ~2.9 GiB of input and ~19 GiB by the formula. 24 GiB
	// carries a quarter over that.
	//
	// STOPGAP, for two reasons. The arithmetic above is tied to ONE library — double the
	// variants or the parent length and the constant is wrong, silently. And a flat request on
	// k8s is a hard reservation, since requests equal limits there.
	//
	// The durable fix is upstream: pt's sizing heuristic is sound, it is the measurement that is
	// blind, because `f.size()` counts only inputs attached with addFile(). Teach it to count
	// p-column inputs and this line deletes itself. Failing that, the expansion could stop
	// happening at all — everything drawn is per-(position, residue), and the
	// per-(variant, position) matrix is an intermediate that is immediately aggregated away.
	ptWf := pt.workflow().mem(24 * units.GiB)

	// Axes come back named by their spec, not by a header a builder assigns, so each
	// is aliased here to the name the rest of this body already uses. Matching on the
	// axis NAME keeps the resolution identical to the setAxisHeader calls it replaces.
	smDf := ptWf.frame(pt.p.column("state", stateCol)).select(
		pt.axis(VARIANT_KEY_AXIS).alias("variantKey"),
		pt.axis(PARENT_ID_AXIS).alias("parentId"),
		pt.axis(POSITION_AXIS).alias("position"),
		pt.col("state")
	)

	// Scope the whole plot to one parent. Everything downstream derives from smDf (heat map
	// cells, the parent-residue track, composition), so a single filter here makes them all
	// single-parent — which is what the position-keyed annotation tracks require. The region
	// track has its own source (bundle column) and is filtered separately below.
	if !is_undefined(args.selectedParentId) {
		smDf = smDf.filter(pt.col("parentId").eq(pt.lit(args.selectedParentId)))
	}

	// --- Region track (optional) ---
	// Collapse the profiler's per-position region membership [parentId, position] -> region to
	// [position] -> region, so it can ride the position (X) axis of the heat map as a GraphMaker
	// annotation track (annotation columns must be keyed solely by the X axis). Scoped to the
	// selected parent first, so the position-keyed collapse is exact for that parent. Emitted only
	// when the profiler supplied region data (aa state matrix with a region scheme); otherwise the
	// bundle query is empty and no track is produced.
	//
	// The profiler exports two readings of the same membership — the widest region containing
	// each position, and the narrowest. This draws ONE band, preferring the narrow one where it
	// exists: its names already carry their framework (CDR2_N, Graft, CDR2_C are readably parts
	// of CDR2), so a second band above it would repeat what the reader can see and cost a row of
	// vertical space on every map. The narrow column is absent unless a region was subdivided,
	// so a run without grafts falls through to the wide one and looks exactly as it did before.
	regionEntries := columns.getColumns("subRegionAnnotation")
	if is_undefined(regionEntries) || len(regionEntries) == 0 {
		regionEntries = columns.getColumns("regionAnnotation")
	}
	hasRegion := !is_undefined(regionEntries) && len(regionEntries) > 0
	if hasRegion {
		regionDf := ptWf.frame(pt.p.column("region", regionEntries[0])).select(
			pt.axis(PARENT_ID_AXIS).alias("parentId"),
			pt.axis(POSITION_AXIS).alias("position"),
			pt.col("region")
		)
		if !is_undefined(args.selectedParentId) {
			regionDf = regionDf.filter(pt.col("parentId").eq(pt.lit(args.selectedParentId)))
		}
		regionDf.
			groupBy("position").
			agg(pt.col("region").cast("String").first().alias("region")).
			save("regionByPosition.tsv")
	}

	// --- Parent-residue track ---
	// Emit [position] -> parentResidue for a GraphMaker annotation track under the X axis.
	// Annotation columns must be keyed solely by that axis, so the profiler's
	// [parentId, position] column is scoped to the selected parent and then collapsed — the same
	// two steps as the region track above.
	//
	// FALLBACK, remove once projects have re-run the profiler: a run predating the exported
	// column resolves to an empty query. Guess the parent residue as the state carried by the
	// most distinct variants (the matrix's default cell IS the parent residue), ties broken
	// alphabetically. Wrong wherever most variants are mutated at a position — and then every
	// single mutant differs from it there and gains an extra cell, which is why the column exists.
	parentResidueEntries := columns.getColumns("parentResidue")
	parentResDf := undefined
	if !is_undefined(parentResidueEntries) && len(parentResidueEntries) > 0 {
		prDf := ptWf.frame(pt.p.column("parentResidue", parentResidueEntries[0])).select(
			pt.axis(PARENT_ID_AXIS).alias("parentId"),
			pt.axis(POSITION_AXIS).alias("position"),
			pt.col("parentResidue")
		)
		if !is_undefined(args.selectedParentId) {
			prDf = prDf.filter(pt.col("parentId").eq(pt.lit(args.selectedParentId)))
		}
		parentResDf = prDf.
			groupBy("position").
			agg(pt.col("parentResidue").cast("String").first().alias("parentResidue"))
	} else {
		// smDf is already scoped to the selected parent, so this collapse is parent-local.
		parentResDf = smDf.
			groupBy("position", "state").
			agg(pt.col("variantKey").count().alias("n")).
			withColumns(pt.col("n").max().over(["position"]).alias("maxN")).
			filter(pt.col("n").eq(pt.col("maxN"))).
			sort(["position", "state"]).
			groupBy("position").
			agg(pt.col("state").cast("String").first().alias("parentResidue"))
	}
	parentResDf.save("parentResidue.tsv")

	// Per-cell parent marking for the landscape: [position, state] -> 1 at the one cell per
	// position whose state IS the parent residue. Present only there, so GraphMaker's Highlight
	// input filters it as a subset ("has a value") and outlines exactly those cells. These are
	// the cells the densified grid supplies and the single-mutant data never does.
	parentFlagLandscapeDf := parentResDf.
		select(pt.col("position"), pt.col("parentResidue").alias("state")).
		withColumns(pt.lit(1).alias("isParentResidue"))
	parentFlagLandscapeDf.save("parentResidueFlagLandscape.tsv")

	// --- Mutation landscape precalc (optional) ---
	// The singleton cell mode: a cell holds the value of the ONE single-mutant variant carrying
	// exactly that substitution, taken directly with no aggregation. The alternative would be a
	// population marginal, pooling every variant carrying the residue — which mixes in the
	// genetic backgrounds the substitution co-occurs with, and is why this block no longer
	// draws one.
	//
	// Two things pin a single mutant to its one real cell. First `mutationCount == 1` selects the
	// variants. Then the substitution has to be located: the state matrix carries the PARENT
	// residue in every position the variant did not mutate, so a naive join would paint each
	// single mutant across the whole parent row. Diffing against the per-position parent residue
	// (derived above from the full population) keeps only the position where the variant actually
	// differs — exactly one row per variant.
	//
	// Cells with no covering single-mutant variant are ABSENT, never filled from a fallback.
	scoreRefs := args.scoreRefs
	mutCountEntries := columns.getColumns("mutationCount")
	hasLandscape := !is_undefined(scoreRefs) && len(scoreRefs) > 0 &&
		!is_undefined(mutCountEntries) && len(mutCountEntries) > 0
	// Filled by the precalc, read by the import section after ptWf.run() — hence declared out here.
	scoreMeta := []
	if hasLandscape {
		// [variantKey] -> mutCount, for every variant. Shared by the landscape's single-mutant
		// predicate and by the drill-down precalc below, so the column is read once.
		mutCounts := ptWf.frame(pt.p.column("mutCount", mutCountEntries[0])).
			select(pt.axis(VARIANT_KEY_AXIS).alias("variantKey"), pt.col("mutCount"))

		singleMutants := mutCounts.
			filter(pt.col("mutCount").eq(pt.lit(1))).
			select(pt.col("variantKey"))

		// One row per MUTATION of EVERY variant — the diff against the per-position
		// parent residue described above, without the single-mutant predicate. The landscape
		// takes the single-mutant subset of it; the drill-down maps take the rest.
		//
		// `mutationId` is the substitution's designator (`A5C`: parent residue, position, new
		// residue), and the key everything in the drill-down hangs off. One string axis, so a
		// chart pins to one mutation with a single equality filter and the UI reuses the same
		// value as the section label and the query parameter.
		// No mutation-count bound. One was carried for a while on the theory that expanding every
		// variant is what killed the step; it was not. The step was dying because the RAM request
		// measured zero (see the pt.workflow comment above) and always came back at the 2 GiB
		// floor — at limit 1 as much as at limit 3. With that fixed the bound only cost spec
		// fidelity: triples and beyond belong in the Table tab, and a co-occurring variant is any
		// variant with more than one mutation, not only a double.
		//
		// The row count here is the sum of mutation counts across variants, which stays far below
		// the `variants x positions` matrix this reads from.
		allMutCells := smDf.
			join(parentResDf, { on: "position", how: "inner" }).
			filter(pt.col("state").neq(pt.col("parentResidue"))).
			withColumns(
				pt.concatStr([
					pt.col("parentResidue"),
					pt.col("position").cast("String"),
					pt.col("state")
				]).alias("mutationId")
			).
			select(
				pt.col("variantKey"),
				pt.col("parentId"),
				pt.col("position"),
				pt.col("state"),
				pt.col("mutationId")
			)

		// [variantKey, parentId, position, state, mutationId] — one row per single-mutant
		// variant, at the position/residue of its own substitution.
		singleMutCells := allMutCells.join(singleMutants, { on: "variantKey", how: "inner" })

		// parentId is dropped again below; kept here so the landscape select is unchanged.
		mutCells := singleMutCells.
			select(pt.col("variantKey"), pt.col("parentId"), pt.col("position"), pt.col("state"))

		// --- Drill-down precalc ---
		// Everything a click needs, computed once for EVERY cell. A click then filters data the
		// block already holds, so it opens instantly and needs no Run — which is what keeps the
		// open sections out of args and stops the block going stale when one is opened.
		//
		// All three outputs are bounded by the variants actually observed, not by the size of the
		// grid. A library with no multi-mutants produces an empty pair map and costs nothing.

		// Co-occurring variants per cell: how many variants carrying this substitution are
		// multi-mutants. Rides the landscape frame on the cell axes, so it reads in the tooltip
		// beside the score and answers "would a drill-down hold anything?" before a click is spent.
		//
		// Left-joined onto the single-mutant cells and null-filled, so a cell the user can see but
		// cannot drill into reads a definite `0` rather than an absent tooltip line. Cells with no
		// single mutant at all have no row here and none on the map either.
		// One row per (mutation, co-occurring variant carrying it) — the base both counts read.
		// Any mutation count above one, so a substitution carried only by triples still counts as
		// browsable and still opens a table, even though the partner map draws doubles alone.
		coOccurringCells := allMutCells.
			join(mutCounts, { on: "variantKey", how: "inner" }).
			filter(pt.col("mutCount").gt(pt.lit(1)))

		coOccurrence := coOccurringCells.
			groupBy("position", "state").
			agg(pt.col("variantKey").count().alias("coOccurringVariants"))

		// The same count keyed by the designator instead of the cell: [mutationId] -> Int, and
		// only for mutations that HAVE a co-occurring variant. The UI enumerates this axis to
		// build the list of substitutions worth browsing, which is exactly the set of cells a
		// click will be allowed to open.
		coOccurringCells.
			groupBy("mutationId").
			agg(pt.col("variantKey").count().alias("coOccurringVariants")).
			save("browsableMutations.tsv")

		// Collapse AFTER the join, not before. Folding to the cell grid first and joining the
		// count onto it reads better and does less work, but ptabler dies on the resulting plan
		// (see the note above the drill-down cell set) — so this keeps the shape that runs.
		singleMutCells.
			select(pt.col("position"), pt.col("state")).
			join(coOccurrence, { on: ["position", "state"], how: "left" }).
			withColumns(pt.col("coOccurringVariants").fillNull(pt.lit(0)).alias("coOccurringVariants")).
			sort(["position", "state"]).
			groupBy("position", "state").
			agg(pt.col("coOccurringVariants").first().alias("coOccurringVariants")).
			save("coOccurringVariants.tsv")

		// Mutation -> variant membership: every variant carrying each substitution, at any
		// mutation count. The Table tab's primary column, annotated as a linker so table
		// discovery hops from it to the variant-keyed columns in the result pool — the block
		// exports the hop, not copies of the upstream data.
		allMutCells.
			select(pt.col("variantKey"), pt.col("mutationId")).
			withColumns(pt.lit(1).alias("carriesMutation")).
			save("mutationVariantLink.tsv")

		// Partner pair map: for each fixed mutation, the second substitution of every double
		// mutant carrying it. Self-join over the doubles on variantKey, keeping both directions
		// so each member of a pair can be the fixed one.
		doubleMutants := mutCounts.
			filter(pt.col("mutCount").eq(pt.lit(2))).
			select(pt.col("variantKey"))

		doubleCells := allMutCells.join(doubleMutants, { on: "variantKey", how: "inner" })

		// The partner side is rebuilt from the state matrix rather than projected out of
		// `doubleCells`, so the two sides of the join below are independent lineages.
		//
		// Joining one lazy node to a projection of ITSELF is the only construct in this workflow
		// that the single-mutant libraries never exercised — with no double mutants that branch
		// is empty and never really runs — and it is the shape present in every failing run.
		// Re-deriving costs one more scan of an already-reduced frame; it buys a plain two-input
		// join over a self-join.
		partnerCells := smDf.
			join(doubleMutants, { on: "variantKey", how: "inner" }).
			join(parentResDf, { on: "position", how: "inner" }).
			filter(pt.col("state").neq(pt.col("parentResidue"))).
			withColumns(
				pt.concatStr([
					pt.col("parentResidue"),
					pt.col("position").cast("String"),
					pt.col("state")
				]).alias("partnerMutation")
			).
			select(
				pt.col("variantKey"),
				pt.col("position").alias("partnerPosition"),
				pt.col("state").alias("partnerState"),
				pt.col("partnerMutation")
			)

		pairCells := doubleCells.
			select(pt.col("variantKey"), pt.col("mutationId")).
			join(partnerCells, { on: "variantKey", how: "inner" }).
			filter(pt.col("mutationId").neq(pt.col("partnerMutation"))).
			select(
				pt.col("mutationId"),
				pt.col("partnerPosition").alias("position"),
				pt.col("partnerState").alias("state"),
				pt.col("partnerMutation"),
				pt.col("variantKey")
			)

		// The fixed mutation is drawn too, in its own cell, carrying the singleton's own measured
		// score — the reference every pair is read against. Concatenated into the same frame so
		// one value column serves both, and flagged separately below so the chart can outline it.
		// `partnerMutation` is materialised before the projection rather than selected as a
		// second reference to `mutationId`. Naming one source column twice in a single select is
		// legal but needless, and this path has been hard enough to debug without it.
		fixedOwnCells := singleMutCells.
			withColumns(pt.col("mutationId").alias("partnerMutation")).
			select(
				pt.col("mutationId"),
				pt.col("position"),
				pt.col("state"),
				pt.col("partnerMutation"),
				pt.col("variantKey")
			)

		drillDownCells := pt.concat([pairCells, fixedOwnCells])

		// NOTE, do not "optimise" this the obvious way. Picking the representative variant per
		// cell once, outside the per-score loop, is score-independent and removes N-1 sorts —
		// but ptabler exits with a signal (code -1, no traceback) on the plan that produces,
		// even on a few thousand rows. The same happened to the co-occurrence count when its
		// aggregation was folded ahead of the join. Both are reverted here; whatever the plan
		// builder dislikes about a shared sort/groupBy node reused by several consumers has to
		// be understood before this is tried again.

		// [mutationId, position, state] -> 1 on the fixed cell only, so GraphMaker's Highlight
		// input outlines it as a subset — the same mechanism as the parent-residue mark above.
		singleMutCells.
			select(pt.col("mutationId"), pt.col("position"), pt.col("state")).
			withColumns(pt.lit(1).alias("isFixedMutation")).
			save("drillDownFixedFlag.tsv")

		// One saved frame per score, NOT one stacked column under a shared `score` axis. A heatmap
		// chart has exactly one colour scale — miplots4 takes the value extent across all facets
		// and offers no per-facet colour option — so scores in different units cannot share a
		// chart. One column per score gives each its own scale.
		for i, ref in scoreRefs {
			sSpec := columns.getSpec(ref)
			scoreLabel := "Score " + string(i + 1)
			if !is_undefined(sSpec) && !is_undefined(sSpec.annotations) && !is_undefined(sSpec.annotations["pl7.app/label"]) {
				scoreLabel = sSpec.annotations["pl7.app/label"]
			}

			// Header carries the loop index: every iteration adds its own frame to the
			// same pt workflow, so a shared header would collide across scores.
			sHeader := "scoreValue_" + string(i)
			sDf := ptWf.frame(pt.p.column(sHeader, columns.getColumn(ref))).select(
				pt.axis(VARIANT_KEY_AXIS).alias("variantKey"),
				pt.col(sHeader).alias("scoreValue")
			)

			scoreFile := "singleMutantLandscape_" + string(i) + ".tsv"

			// Guarantee one row per cell. In a true single-mutant library exactly one variant covers
			// a cell, so `first` IS that variant's value — no aggregation happens. The sort makes the
			// outcome deterministic in the degenerate case where a library encodes the same
			// substitution under two variant keys, instead of failing the import on duplicate keys.
			// No parentId: already scoped to one parent, so the axis would be constant — and
			// GraphMaker demands every axis be consumed by an input, which put a one-choice
			// "Show for" selector above the plot.
			mutCells.
				join(sDf, { on: "variantKey", how: "inner" }).
				select(
					pt.col("position"),
					pt.col("state"),
					pt.col("variantKey"),
					// Cast so an integer-valued score still lands in the Double-typed imported
					// column.
					pt.col("scoreValue").cast("Double").alias("scoreValue")
				).
				sort(["position", "state", "variantKey"]).
				groupBy("position", "state").
				agg(pt.col("scoreValue").first().alias("cellValue")).
				save(scoreFile)

			// The drill-down carries the score whose map was clicked, so it never silently
			// changes what it is measuring — hence one pair frame per score, keyed the same way
			// as the landscape's. Same one-row-per-cell guarantee: within a fixed mutation a
			// partner cell is one double mutant, so `first` IS that variant's value.
			// One row per cell, per score. The sort makes `first` deterministic where a library
			// encodes the same pair under two variant keys.
			pairFile := "drillDownPairs_" + string(i) + ".tsv"
			drillDownCells.
				join(sDf, { on: "variantKey", how: "inner" }).
				select(
					pt.col("mutationId"),
					pt.col("position"),
					pt.col("state"),
					pt.col("partnerMutation"),
					pt.col("variantKey"),
					pt.col("scoreValue").cast("Double").alias("scoreValue")
				).
				sort(["mutationId", "position", "state", "variantKey"]).
				groupBy("mutationId", "position", "state").
				agg(
					pt.col("scoreValue").first().alias("cellValue"),
					pt.col("partnerMutation").cast("String").first().alias("partnerMutation"),
					pt.col("variantKey").cast("String").first().alias("variantKey")
				).
				save(pairFile)

			scoreMeta = scoreMeta + [{
				index: i,
				label: scoreLabel,
				ref: ref,
				file: scoreFile,
				pairFile: pairFile
			}]
		}
	}

	// --- Composition-enrichment precalc (optional) ---
	// Positional composition shift across rounds: log2(round fraction / baseline fraction),
	// on the per-position composition frequency (A-0019). Consumes the enrichment block's
	// per-round per-variant frequency columns. Round identity comes from each column's
	// `pl7.app/enrichment/condition` domain; round order (baseline = first) from the args
	// array. Frequencies are fractions, so zeros are guarded by a small epsilon, not a
	// count pseudocount.
	// Need at least two rounds: one baseline plus one comparison. With a single round the
	// baseline is filtered out below, leaving an empty result — so gate it out entirely.
	roundRefs := args.roundFrequencyRefs
	hasComposition := !is_undefined(roundRefs) && len(roundRefs) >= 2
	if hasComposition {
		eps := args.compositionEpsilon

		// Long per-round frequency frame [variantKey, round, freq].
		roundFrames := []
		baselineRound := undefined
		for i, ref in roundRefs {
			rSpec := columns.getSpec(ref)
			roundId := string(i)
			if !is_undefined(rSpec) && !is_undefined(rSpec.domain) && !is_undefined(rSpec.domain["pl7.app/enrichment/condition"]) {
				roundId = rSpec.domain["pl7.app/enrichment/condition"]
			}
			// GraphMaker orders facets by the round axis label (numeric-collation sort), with
			// no facet-order override — so the label must lead with the arrangement index for
			// the panels to render in the user's chosen order. Skip the prefix when the round
			// name is already that ordinal index (avoids a redundant "1. 1"); the bare name is
			// then just the index, so ordering still holds.
			roundKey := roundId
			if roundId != string(i) {
				roundKey = string(i) + ". " + roundId
			}
			if is_undefined(baselineRound) {
				baselineRound = roundKey
			}
			// Header carries the loop index — one frame per round in the same workflow.
			rHeader := "freq_" + string(i)
			rDf := ptWf.frame(pt.p.column(rHeader, columns.getColumn(ref))).
				select(
					pt.axis(VARIANT_KEY_AXIS).alias("variantKey"),
					pt.col(rHeader).alias("freq")
				).
				withColumns(pt.lit(roundKey).alias("round"))
			roundFrames = roundFrames + [rDf]
		}
		freqDf := roundFrames[0]
		if len(roundFrames) > 1 {
			freqDf = pt.concat(roundFrames)
		}

		// Composition fraction per (round, parentId, position, state): the per-round
		// frequency scattered onto positions via the state matrix, summed per residue,
		// then normalized per (round, parentId, position) column (A-0011).
		compFrac := smDf.join(freqDf, { on: "variantKey", how: "inner" }).
			groupBy("round", "parentId", "position", "state").
			agg(pt.col("freq").sum().alias("posSum")).
			withColumns(
				pt.col("posSum").
					truediv(pt.col("posSum").sum().over(["round", "parentId", "position"])).
					alias("frac")
			).
			select(pt.col("round"), pt.col("parentId"), pt.col("position"), pt.col("state"), pt.col("frac"))

		// Full (round × cell) grid, zero-filled, so residues absent in a round or the
		// baseline still appear (emergence / depletion) rather than dropping out.
		cells := compFrac.select(pt.col("parentId"), pt.col("position"), pt.col("state")).unique()
		roundsU := compFrac.select(pt.col("round")).unique()
		gridDf := roundsU.join(cells, { how: "cross" }).
			join(compFrac, { on: ["round", "parentId", "position", "state"], how: "left" }).
			withColumns(pt.col("frac").fillNull(pt.lit(0)).alias("frac"))

		// Baseline fractions keyed by cell; zero where the baseline lacks the residue.
		baseFrac := compFrac.filter(pt.col("round").eq(pt.lit(baselineRound))).
			select(pt.col("parentId"), pt.col("position"), pt.col("state"), pt.col("frac").alias("baseFrac"))

		// Drop the baseline round's own panel — it is log2(f/f)=0 everywhere by construction
		// and carries no signal. Panels shown = one per non-baseline round.
		compDf := gridDf.join(baseFrac, { on: ["parentId", "position", "state"], how: "left" }).
			withColumns(pt.col("baseFrac").fillNull(pt.lit(0)).alias("baseFrac")).
			withColumns(
				pt.col("frac").plus(pt.lit(eps)).
					truediv(pt.col("baseFrac").plus(pt.lit(eps))).
					log2().
					alias("log2fc")
			).
			filter(pt.col("round").neq(pt.lit(baselineRound))).
			select(pt.col("round"), pt.col("parentId"), pt.col("position"), pt.col("state"), pt.col("log2fc"))

		compDf.save("compositionHeatmap.tsv")

		// Per-cell flag marking the parent residue at each position, for GraphMaker's Highlight
		// input: the cell whose state IS the parent is outlined, the rest are not. Keyed
		// [parentId, position, state] — a subset of the composition cell's axes, so every round
		// gets the same marking from one column.
		//
		// A SUBSET column: only the parent cells are present, and a cell absent from it reads as
		// null after the join, which is what `pl7.app/isSubset` tells GraphMaker to filter on.
		// The same grid the cells come from, so a marked cell always has a cell to mark.
		parentFlagDf := cells.join(parentResDf, { on: "position", how: "inner" }).
			filter(pt.col("state").eq(pt.col("parentResidue"))).
			withColumns(pt.lit(1).alias("isParentResidue")).
			select(pt.col("parentId"), pt.col("position"), pt.col("state"), pt.col("isParentResidue"))
		parentFlagDf.save("parentResidueFlag.tsv")
	}

	ptResult := ptWf.run()

	trace := pSpec.makeTrace(stateSpec, {
		type: "milaboratories.repertoire-mutation-heatmap",
		importance: 50,
		label: "Mutation Explorer"
	})

	// Region annotation track: [position] -> region, keyed on the same position axis as the
	// value columns, so GraphMaker aligns it under the X axis. String value → discrete
	// annotation. Added to both the landscape and composition frames; the UI presets it as an
	// annotationsX track on each page.
	regionCols := undefined
	if hasRegion {
		regionCols = xsv.importFile(
			ptResult.getFile("regionByPosition.tsv"),
			"tsv",
			{
				axes: [{ column: "position", spec: positionAxisSpec }],
				columns: [{
					column: "region",
					spec: {
						name: "pl7.app/repertoire/regionAnnotation",
						valueType: "String",
						annotations: {
							"pl7.app/label": "Region"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
	}
	// Parent-residue track: [position] -> parentResidue, keyed on the same position axis as the
	// value columns. String value → discrete annotation coloured by residue; the residue shows
	// in the tooltip. Added to the same frames as the region track, which the UI presets as
	// annotationsX alongside it.
	parentCols := xsv.importFile(
		ptResult.getFile("parentResidue.tsv"),
		"tsv",
		{
			axes: [{ column: "position", spec: positionAxisSpec }],
			columns: [{
				column: "parentResidue",
				spec: {
					name: "pl7.app/repertoire/parentResidue",
					valueType: "String",
					domain: {
						"pl7.app/alphabet": alphabet
					},
					annotations: {
						"pl7.app/label": (alphabet == "aminoacid") ? "Parent AA" : "Parent NT",
						"pl7.app/table/fontFamily": "monospace"
					}
				}
			}],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		},
		{ splitDataAndSpec: true }
	)
	outputs := {}

	// --- Single-mutant landscape import + export (optional) ---
	// One value column per score, each [position, state] -> cellValue, scoped to the selected
	// parent. Position is inherited from the profiler; state is block-local. Neither score nor
	// parent is an axis — see the precalc above.
	// No in-block normalization: these are per-variant scores that arrive already normalized
	// upstream, and dividing one by a position-column total would answer nothing.
	if hasLandscape {
		lsPf := pframes.pFrameBuilder()
		for m in scoreMeta {
			lsCols := xsv.importFile(
				ptResult.getFile(m.file),
				"tsv",
				{
					axes: [
						{ column: "position", spec: densePositionAxisSpec },
						{ column: "state", spec: denseStateAxisSpec }
					],
					columns: [{
						column: "cellValue",
						spec: {
							name: "pl7.app/repertoire/singleMutantValue",
							valueType: "Double",
							domain: {
								"pl7.app/alphabet": alphabet,
								// Every score column shares name and axes, so identity needs one
								// differing key. Index only — the durable score identity is the
								// ref annotation below.
								"pl7.app/repertoire/landscapeScore": string(m.index)
							},
							annotations: {
								"pl7.app/label": m.label,
								"pl7.app/isScore": "true",
								// The UI keys each chart's saved settings on this, so settings
								// survive a reorder. Annotation, not domain: lineage, not identity.
								"pl7.app/repertoire/landscapeScoreRef": m.ref,
								"pl7.app/repertoire/landscapeScoreIndex": string(m.index)
							}
						}
					}],
					storageFormat: "Parquet",
					partitionKeyLength: 0
				},
				{ splitDataAndSpec: true }
			)
			// Index prefix: every score's import returns the same keys into one frame.
			for k, v in lsCols {
				lsPf.add("score" + string(m.index) + "/" + k, trace.inject(v.spec), v.data)
			}
		}
		// Same position-keyed region + parent-residue tracks as the state heat map — this plot
		// shares the position (X) axis and the selected parent, so they align.
		if hasRegion {
			for k, v in regionCols {
				lsPf.add("region/" + k, trace.inject(v.spec), v.data)
			}
		}
		for k, v in parentCols {
			lsPf.add("parent/" + k, trace.inject(v.spec), v.data)
		}
		// Parent-residue marking, [position, state] -> 1 on the parent cell only. Its axes are
		// the cell's own, so GraphMaker accepts it as a per-cell source for Highlight; the
		// non-dense copies are deliberate, since this column has no holes to fill.
		parentFlagLsCols := xsv.importFile(
			ptResult.getFile("parentResidueFlagLandscape.tsv"),
			"tsv",
			{
				axes: [
					{ column: "position", spec: positionAxisSpec },
					{ column: "state", spec: stateAxisSpecBase }
				],
				columns: [{
					column: "isParentResidue",
					spec: {
						name: "pl7.app/repertoire/isParentResidue",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": (alphabet == "aminoacid") ? "Is parent AA" : "Is parent NT",
							// Present-or-absent, not a number: GraphMaker's Highlight input then
							// defaults to the subset filter instead of asking for a range.
							"pl7.app/isSubset": "true"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		for k, v in parentFlagLsCols {
			lsPf.add("parentFlag/" + k, trace.inject(v.spec), v.data)
		}
		// Co-occurring variant count, [position, state] -> Int on the same cell axes as the
		// scores. The UI puts it in the tooltip basket, so hovering answers whether a cell has
		// anything to drill into before the click is spent. Non-dense like the parent flag: it
		// carries a row for exactly the cells the map draws, and a definite 0 where there is
		// nothing to browse.
		coOccurrenceCols := xsv.importFile(
			ptResult.getFile("coOccurringVariants.tsv"),
			"tsv",
			{
				axes: [
					{ column: "position", spec: positionAxisSpec },
					{ column: "state", spec: stateAxisSpecBase }
				],
				columns: [{
					column: "coOccurringVariants",
					spec: {
						name: "pl7.app/repertoire/coOccurringVariants",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": "Co-occurring variants"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		for k, v in coOccurrenceCols {
			lsPf.add("coOccurrence/" + k, trace.inject(v.spec), v.data)
		}
		outputs.singleMutantHeatmapPf = pframes.exportFrame(lsPf.build())

		// --- Drill-down import + export ---
		// Partner map: [mutationId, position, state] -> cellValue, one value column per score.
		// The chart pins mutationId to the clicked substitution and draws position x state, so
		// each cell is the partner of a double mutant; the fixed mutation sits in its own cell,
		// outlined by the flag column.
		ddPf := pframes.pFrameBuilder()
		for m in scoreMeta {
			ddCols := xsv.importFile(
				ptResult.getFile(m.pairFile),
				"tsv",
				{
					axes: [
						{ column: "mutationId", spec: mutationIdAxisSpec },
						{ column: "position", spec: positionAxisSpec },
						{ column: "state", spec: stateAxisSpecBase }
					],
					columns: [
						{
							column: "cellValue",
							spec: {
								name: "pl7.app/repertoire/pairMutantValue",
								valueType: "Double",
								domain: {
									"pl7.app/alphabet": alphabet,
									// Same reason as the landscape: every score column shares name
									// and axes, so identity needs one differing key.
									"pl7.app/repertoire/landscapeScore": string(m.index)
								},
								annotations: {
									"pl7.app/label": m.label,
									"pl7.app/isScore": "true",
									// The UI matches a drill-down chart to its score on this, the
									// same annotation the landscape charts are keyed on.
									"pl7.app/repertoire/landscapeScoreRef": m.ref,
									"pl7.app/repertoire/landscapeScoreIndex": string(m.index)
								}
							}
						},
						{
							column: "partnerMutation",
							spec: {
								name: "pl7.app/repertoire/partnerMutation",
								valueType: "String",
								domain: {
									"pl7.app/alphabet": alphabet,
									"pl7.app/repertoire/landscapeScore": string(m.index)
								},
								annotations: {
									"pl7.app/label": "Partner mutation",
									"pl7.app/table/fontFamily": "monospace"
								}
							}
						},
						{
							column: "variantKey",
							spec: {
								name: "pl7.app/repertoire/pairVariantKey",
								valueType: "String",
								domain: {
									"pl7.app/alphabet": alphabet,
									"pl7.app/repertoire/landscapeScore": string(m.index)
								},
								annotations: {
									"pl7.app/label": "Variant",
									"pl7.app/table/fontFamily": "monospace"
								}
							}
						}
					],
					storageFormat: "Parquet",
					partitionKeyLength: 0
				},
				{ splitDataAndSpec: true }
			)
			for k, v in ddCols {
				ddPf.add("pair" + string(m.index) + "/" + k, trace.inject(v.spec), v.data)
			}
		}
		// The fixed mutation's own cell, present only there, so Highlight outlines exactly it.
		ddFlagCols := xsv.importFile(
			ptResult.getFile("drillDownFixedFlag.tsv"),
			"tsv",
			{
				axes: [
					{ column: "mutationId", spec: mutationIdAxisSpec },
					{ column: "position", spec: positionAxisSpec },
					{ column: "state", spec: stateAxisSpecBase }
				],
				columns: [{
					column: "isFixedMutation",
					spec: {
						name: "pl7.app/repertoire/isFixedMutation",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": "Is fixed mutation",
							// Present-or-absent, so Highlight defaults to the subset filter.
							"pl7.app/isSubset": "true"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		for k, v in ddFlagCols {
			ddPf.add("fixedFlag/" + k, trace.inject(v.spec), v.data)
		}
		// Same position-keyed tracks as the landscape — the partner map shares the position axis
		// and the selected parent, so they align cell for cell.
		if hasRegion {
			for k, v in regionCols {
				ddPf.add("region/" + k, trace.inject(v.spec), v.data)
			}
		}
		for k, v in parentCols {
			ddPf.add("parent/" + k, trace.inject(v.spec), v.data)
		}
		outputs.drillDownHeatmapPf = pframes.exportFrame(ddPf.build())

		// Mutation -> variant membership, [mutationId, variantKey] -> 1, exported on its own.
		// variantKey sits at axis 0: a linker is matched positionally, and the columns the table
		// reaches through it are variant-keyed. Annotated as a linker so table discovery makes
		// the hop instead of offering the column itself.
		linkCols := xsv.importFile(
			ptResult.getFile("mutationVariantLink.tsv"),
			"tsv",
			{
				axes: [
					{ column: "variantKey", spec: stateSpec.axesSpec[0] },
					{ column: "mutationId", spec: mutationIdAxisSpec }
				],
				columns: [{
					column: "carriesMutation",
					spec: {
						name: "pl7.app/repertoire/mutationVariantLink",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": "Carries mutation",
							"pl7.app/isLinkerColumn": "true"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		linkPf := pframes.pFrameBuilder()
		for k, v in linkCols {
			linkPf.add("link/" + k, trace.inject(v.spec), v.data)
		}
		outputs.mutationVariantLinkPf = pframes.exportFrame(linkPf.build())

		// Browsable mutations, [mutationId] -> co-occurring variant count. Its own frame so the
		// UI can enumerate the axis (getUniqueSourceValuesWithLabels needs a frame and a column
		// id) without pulling in the pair map.
		browsableCols := xsv.importFile(
			ptResult.getFile("browsableMutations.tsv"),
			"tsv",
			{
				axes: [{ column: "mutationId", spec: mutationIdAxisSpec }],
				columns: [{
					column: "coOccurringVariants",
					spec: {
						name: "pl7.app/repertoire/browsableMutation",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": "Co-occurring variants"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		browsablePf := pframes.pFrameBuilder()
		for k, v in browsableCols {
			browsablePf.add("browsable/" + k, trace.inject(v.spec), v.data)
		}
		outputs.browsableMutationsPf = pframes.exportFrame(browsablePf.build())
	}

	// --- Composition heat map import + export (optional) ---
	// [round, parentId, position, state] -> log2FC. parentId / position inherited from the
	// profiler; round and state are block-local. The value is signed → tagged for the
	// diverging colour scale (A-0017) via a block-owned annotation the UI reads.
	if hasComposition {
		compCols := xsv.importFile(
			ptResult.getFile("compositionHeatmap.tsv"),
			"tsv",
			{
				axes: [
					{
						column: "round",
						spec: {
							name: "pl7.app/repertoire/round",
							type: "String",
							annotations: {
								"pl7.app/label": "Round"
							}
						}
					},
					{ column: "parentId", spec: parentAxisSpec },
					{ column: "position", spec: positionAxisSpec },
					{
						column: "state",
						spec: {
							name: "pl7.app/repertoire/state",
							type: "String",
							domain: {
								"pl7.app/alphabet": alphabet
							},
							annotations: {
								"pl7.app/label": stateAxisLabel,
								"pl7.app/table/fontFamily": "monospace"
							}
						}
					}
				],
				columns: [{
					column: "log2fc",
					spec: {
						name: "pl7.app/repertoire/compositionLog2FC",
						valueType: "Double",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": "Composition log2 fold change",
							"pl7.app/isScore": "true",
							"pl7.app/heatmap/colorScale": "diverging"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)
		// Parent-residue marking, [parentId, position, state] -> 1 for the parent cell only.
		// Absent everywhere else, so the Highlight input's subset filter outlines exactly those
		// cells. Shares parentId / position / state with the value column, so GraphMaker accepts
		// it as a per-cell source.
		parentFlagCols := xsv.importFile(
			ptResult.getFile("parentResidueFlag.tsv"),
			"tsv",
			{
				axes: [
					{ column: "parentId", spec: parentAxisSpec },
					{ column: "position", spec: positionAxisSpec },
					{
						column: "state",
						spec: {
							name: "pl7.app/repertoire/state",
							type: "String",
							domain: {
								"pl7.app/alphabet": alphabet
							},
							annotations: {
								"pl7.app/label": stateAxisLabel,
								"pl7.app/table/fontFamily": "monospace"
							}
						}
					}
				],
				columns: [{
					column: "isParentResidue",
					spec: {
						name: "pl7.app/repertoire/isParentResidue",
						valueType: "Int",
						domain: {
							"pl7.app/alphabet": alphabet
						},
						annotations: {
							"pl7.app/label": (alphabet == "aminoacid") ? "Is parent AA" : "Is parent NT",
							// Present-or-absent, not a number: GraphMaker's Highlight input then
							// defaults to the subset filter instead of asking for a range.
							"pl7.app/isSubset": "true"
						}
					}
				}],
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			{ splitDataAndSpec: true }
		)

		compPf := pframes.pFrameBuilder()
		for k, v in compCols {
			compPf.add(k, trace.inject(v.spec), v.data)
		}
		for k, v in parentFlagCols {
			compPf.add("parentFlag/" + k, trace.inject(v.spec), v.data)
		}
		// Same position-keyed region + parent-residue tracks as the state heat map — the
		// composition plot shares the position (X) axis and the selected parent, so they align.
		if hasRegion {
			for k, v in regionCols {
				compPf.add("region/" + k, trace.inject(v.spec), v.data)
			}
		}
		for k, v in parentCols {
			compPf.add("parent/" + k, trace.inject(v.spec), v.data)
		}
		outputs.compositionHeatmapPf = pframes.exportFrame(compPf.build())
	}

	return {
		outputs: outputs,
		exports: {}
	}
})
